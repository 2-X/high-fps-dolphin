#!/bin/zsh
# Super Mario Sunshine launcher — one command.
#   ./sms            launch the TUI
#   ./sms setup      run the first-run setup wizard (ISO, Dolphin, config kit)
# Bootstraps its own venv on first run; pins deps from requirements.txt.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/.venv"

# Python 3.10+ required (textual needs match-statement syntax in 3.10,
# and type-union shorthand `X | Y` used throughout).
_py=python3
if ! "$_py" --version 2>&1 | grep -qE 'Python 3\.(1[0-9]|[2-9][0-9])'; then
  echo "[sms] Python 3.10 or later is required." >&2
  echo "      Found: $("$_py" --version 2>&1)" >&2
  echo "      Install via: brew install python@3.12" >&2
  exit 1
fi

if [ ! -x "$VENV/bin/python" ]; then
  echo "[sms] creating venv…"
  "$_py" -m venv "$VENV"
  "$VENV/bin/pip" -q install --upgrade pip >/dev/null
fi

# Always sync deps against requirements.txt so a fresh clone or an upgraded
# requirements.txt installs the right pinned versions without manual steps.
"$VENV/bin/pip" -q install -r "$DIR/requirements.txt"

cd "$DIR"

# `./sms setup` -> the first-run setup wizard. Everything else -> the TUI.
if [ "$1" = "setup" ]; then
  exec "$VENV/bin/python" -m smslaunch.setup_wizard
fi
exec "$VENV/bin/python" -m smslaunch
