#!/bin/zsh
# Super Mario Sunshine launcher — one command.
#   ./sms            launch the TUI
# Bootstraps its own venv (Textual) on first run.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  echo "[sms] creating venv…"
  python3 -m venv "$VENV"
  "$VENV/bin/pip" -q install --upgrade pip >/dev/null
  "$VENV/bin/pip" -q install textual
fi
cd "$DIR"
exec "$VENV/bin/python" -m smslaunch
