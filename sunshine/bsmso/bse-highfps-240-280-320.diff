diff --git a/src/globals.cpp b/src/globals.cpp
index 3129534..10fa6d6 100644
--- a/src/globals.cpp
+++ b/src/globals.cpp
@@ -82,7 +82,14 @@ f32 BetterSMS::getScreenToFullScreenRatio() {
 f32 BetterSMS::getScreenRatioAdjustX() { return (getScreenToFullScreenRatio() - 1.0f) * 300.0f; }
 
 f32 BetterSMS::getFrameRate() {
-    const f32 FPS = static_cast<f32>(30 << gFPSSetting.getInt());
+    // 240/280/320 break the old `30 << value` pattern, so use a lookup table.
+    static const f32 sFrameRateTable[6] = {30.0f, 60.0f, 120.0f, 240.0f, 280.0f, 320.0f};
+
+    int value = gFPSSetting.getInt();
+    if (value < 0 || value > 5)
+        value = 0;
+
+    const f32 FPS = sFrameRateTable[value];
 
     return SMS_PORT_REGION(FPS, FPS / 1.2, FPS, FPS);
 }
