diff --git a/src/patches/fps.cpp b/src/patches/fps.cpp
index e0a2e4a..d05ca1e 100644
--- a/src/patches/fps.cpp
+++ b/src/patches/fps.cpp
@@ -27,6 +27,26 @@ BETTER_SMS_FOR_CALLBACK void updateFPS(TMarDirector *director) {
         *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x804167B8, 0x8040DD10, 0, 0)) = 2.0f;
         *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x80414904, 0x8040BE54, 0, 0)) = 0.04f;
         break;
+    case FPSSetting::FPS_240:
+        // Timestep globals follow the established pattern:
+        //   0x804167B8 = FPS / 60   (0.5, 1.0, 2.0, ...)
+        //   0x80414904 = FPS / 3000 (0.01, 0.02, 0.04, ...)
+        // Pacing above 60 comes from the host (Dolphin EmulationSpeed = FPS/60),
+        // so mRetraceCount stays 0 like FPS_120.
+        gpApplication.mDisplay->mRetraceCount                                   = 0;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x804167B8, 0x8040DD10, 0, 0)) = 4.0f;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x80414904, 0x8040BE54, 0, 0)) = 0.08f;
+        break;
+    case FPSSetting::FPS_280:
+        gpApplication.mDisplay->mRetraceCount                                   = 0;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x804167B8, 0x8040DD10, 0, 0)) = 4.6666667f;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x80414904, 0x8040BE54, 0, 0)) = 0.09333333f;
+        break;
+    case FPSSetting::FPS_320:
+        gpApplication.mDisplay->mRetraceCount                                   = 0;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x804167B8, 0x8040DD10, 0, 0)) = 5.3333335f;
+        *reinterpret_cast<f32 *>(SMS_PORT_REGION(0x80414904, 0x8040BE54, 0, 0)) = 0.10666667f;
+        break;
     }
 }
 
